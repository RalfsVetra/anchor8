root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.s]
indent_style = tab
indent_size = 8

[*.{c,h}]
indent_style = tab
indent_size = 8

[*.lkf]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab
indent_size = 8