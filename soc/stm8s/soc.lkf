+seg .vector -b 0x8000 -m 0x80
build/soc/stm8s/vector.o

+seg .text -b 0x8080 -n .text
build/soc/stm8s/crt0.o
build/src/anchor8.o
build/src/protocol.o
build/drivers/serial/uart_stm8.o
build/drivers/flash/flash_stm8.o
build/soc/stm8s/soc.o

+seg .const -a .text
+seg .bsct -b 0x0 -m 0x100
+seg .data -b 0x100 -n .data
+seg .bss -a .data

# +def __endzp=@.ubsct
# +def __memory=@.bss
+def __stack=0x3ff
