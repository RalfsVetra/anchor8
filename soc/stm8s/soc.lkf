+seg .vector -b 0x8000 -m 0x80

+seg .text -b 0x8080 -n .text
+seg .const -a .text -n .const

+seg .bsct -b 0x0 -m 0x100 -n .bsct
+seg .ubsct -a .bsct -n .ubsct
+seg .data -b 0x100 -n .data
+seg .bss -a .data -n .bss

@1
"C:\Program Files (x86)\COSMIC\FSE_Compilers\CXSTM8\Lib\crtsi0.sm8"
@2
@3
@4
@5
@6
"C:\Program Files (x86)\COSMIC\FSE_Compilers\CXSTM8\Lib\libm.sm8"

+def __endzp=@.ubsct
+def __memory=@.bss
+def __stack=0x3ff
